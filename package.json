{
  "name": "video-studio",
  "version": "1.0.2",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "start": "vite build && cross-env NODE_ENV=production electron .",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true
  },
  "author": "Video Studio",
  "description": "Video Studio",
  "build": {
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "productName": "Video Studio",
    "extraResources": [
      {
        "to": "backend",
        "from": "backend/dist/backend"
      },
      {
        "to": "bin",
        "from": "bin"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "appId": "com.videostudio.app",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    }
  }
}
